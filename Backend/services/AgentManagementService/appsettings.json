{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=agents;Username=postgres;Password=pass;TrustServerCertificate=true"
  },
  "Services": {
    "User": "http://localhost:5004"
  },
  "CommandDelivery": {
    "PollIntervalSeconds": 5,
    "DispatchTimeoutSeconds": 30,
    "MaxDeliveryAttempts": 5,
    "RetryBaseDelaySeconds": 5,
    "RetryMaxDelaySeconds": 300,
    "BatchSize": 200
  },
  "Jwt": {
    "Key": "ThisIsASecretKeyForJWTTokenGeneration123456789",
    "Issuer": "ActivityMonitoringSystem",
    "Audience": "ActivityMonitoringSystem",
    "ExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  }
}
