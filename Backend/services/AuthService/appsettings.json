{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=auth;Username=postgres;Password=__SET_VIA_ENV__;TrustServerCertificate=true"
  },
  "Jwt": {
    "ActiveKeyId": "v1",
    "Keys": {
      "v1": "__SET_VIA_ENV__"
    },
    "Key": "__SET_VIA_ENV__",
    "Issuer": "ActivityMonitoringSystem",
    "Audience": "ActivityMonitoringSystem",
    "RequireHttpsMetadata": false,
    "ExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3443"
    ]
  },
  "OpenTelemetry": {
    "ServiceName": "auth-service"
  }
}
