# Core secrets
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
RABBITMQ_USER=REPLACE_WITH_RABBIT_USER
RABBITMQ_PASS=REPLACE_WITH_STRONG_RABBIT_PASSWORD
RABBITMQ_VHOST=/
JWT_ACTIVE_KEY_ID=v1
JWT_KEYS_V1=REPLACE_WITH_AT_LEAST_32_CHARS_SECRET_V1
JWT_KEYS_V2=
JWT_REQUIRE_HTTPS_METADATA=true

# Agent control plane signing
AGENT_SIGNING_KEY_ID=default
AGENT_SIGNING_SECRET=REPLACE_WITH_CONTROL_PLANE_SIGNING_SECRET

# Agent transport auth (gRPC metadata header)
AGENT_AUTH_HEADER=x-agent-token
AGENT_AUTH_TOKEN=REPLACE_WITH_AGENT_TRANSPORT_TOKEN

# Public frontend ports and allowed origins
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
CORS_ORIGIN_0=https://app.example.com
CORS_ORIGIN_1=https://admin.example.com

# Observability admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_ADMIN_PASSWORD
