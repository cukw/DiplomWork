      "id": 2,
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count[5m])), 0.001))",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Error Rate",
      "type": "stat"
