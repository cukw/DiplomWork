        <mxCell id="note1" value="Создание объекта «Уведомление»:&#xa;1) SendNotification (gRPC)&#xa;2) ActivityCreatedEventHandler&#xa;3) AnomalyDetectedEventHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
