        <mxCell id="s_deleted" value="Удалено&#xa;(запись удалена из notifications)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
