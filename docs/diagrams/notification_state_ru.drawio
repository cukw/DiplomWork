        <mxCell id="note2" value="Важно: попытка доставки (email/webhook/in_app)&#xa;не меняет сохранённое состояние в БД.&#xa;При ошибке объект остаётся «Непрочитано»." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="330" width="340" height="100" as="geometry" />
