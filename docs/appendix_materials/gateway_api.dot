digraph GatewayApi {
  rankdir=TB;
  graph [fontname="Times New Roman", fontsize=12, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=10];
  edge [color="#4A4A4A"];
  gateway [label="Gateway REST API", fillcolor="#FFF8E5", color="#AA7A00"];
  agent [label="AgentController", fillcolor="#FFFFFF", color="#2F5D9A"];
  alertrules [label="AlertRulesController", fillcolor="#FFFFFF", color="#2F5D9A"];
  appsettings [label="AppSettingsController", fillcolor="#FFFFFF", color="#2F5D9A"];
  audit [label="AuditController", fillcolor="#FFFFFF", color="#2F5D9A"];
  auth [label="AuthController", fillcolor="#FFFFFF", color="#2F5D9A"];
  dashboard [label="DashboardController", fillcolor="#FFFFFF", color="#2F5D9A"];
  downloads [label="DownloadsController", fillcolor="#FFFFFF", color="#2F5D9A"];
  live [label="LiveController", fillcolor="#FFFFFF", color="#2F5D9A"];
  metrics [label="MetricsController", fillcolor="#FFFFFF", color="#2F5D9A"];
  notification [label="NotificationController", fillcolor="#FFFFFF", color="#2F5D9A"];
  rbac [label="RbacController", fillcolor="#FFFFFF", color="#2F5D9A"];
  reportservice [label="ReportServiceController", fillcolor="#FFFFFF", color="#2F5D9A"];
  reports [label="ReportsController", fillcolor="#FFFFFF", color="#2F5D9A"];
  search [label="SearchController", fillcolor="#FFFFFF", color="#2F5D9A"];
  system [label="SystemController", fillcolor="#FFFFFF", color="#2F5D9A"];
  user [label="UserController", fillcolor="#FFFFFF", color="#2F5D9A"];
  gateway -> agent;
  gateway -> alertrules;
  gateway -> appsettings;
  gateway -> audit;
  gateway -> auth;
  gateway -> dashboard;
  gateway -> downloads;
  gateway -> live;
  gateway -> metrics;
  gateway -> notification;
  gateway -> rbac;
  gateway -> reportservice;
  gateway -> reports;
  gateway -> search;
  gateway -> system;
  gateway -> user;
}
